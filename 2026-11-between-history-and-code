<script>
const NOTES=[["Hello, everyone. / Thank you / for having me here.", "My name is / Younghwa Song. / I am a historian. / I am also / a developer.", "My title today: / “Between History / and Code.” / A historian's journey / to digital history.", "This is not / a success story. / I'm sharing / my journey. / I am still / figuring things out.", "I hope / it helps you. / Maybe you come / from data. / Maybe you come / from the humanities. / Let's start."], ["First, a short / introduction.", "As a historian, / I have a PhD / in Korean history. / I finished in 2023. / I study / the Korean diaspora / in Russia.", "In 2025, / I published a monograph: / “Beyond Naturalization.”", "As a developer, / I work for / an education company / in Japan. / We do tech training / and career support.", "So I live / in two worlds. / The archive, / and the code editor."], ["Let's start / with my classic way.", "I worked / in archives / in Vladivostok. / This is the archive: / Russian State / Historical Archive / of the Far East.", "I did close reading. / I used / qualitative methods. / I read slowly, / one by one.", "I asked / three questions. / Who wrote this? / Why did they / write it? / And for whom?", "These habits / are not old-fashioned. / They are the engine / of history.", "Quantitative history / felt far away. / Nobody around me / used it.", "And there is inertia. / You keep going, / because it is familiar. / Maybe you know / this feeling."], ["Then, a surprise. / I had a project: / overseas jobs / for Korean students.", "My question: / who goes abroad / the most?", "The answer / was a surprise. / Software engineers.", "I did not / expect that. / It stayed / in my mind."], ["Why did I / start coding?", "I wanted to balance / money and research. / My funding failed. / I needed cash.", "And I was lucky. / The COVID / developer boom.", "This chart / shows it. / Developer jobs / went up fast.", "So I learned / to code / for a living."], ["Hard working / conditions.", "First, system integration / in Korea. / Some projects / were mission-critical.", "Reading, thinking, asking / kept me going. / Tradition / was my anchor.", "Next: messy / data cleansing. / It was a system / engineering service / in Japan.", "By chance, / it was basic / data science. / The data / was recruitment data.", "I saw / who was hired. / And who / was not. / I saw Japan / in rows / and columns.", "I learned three things. / First, data / is never clean. / Second, data / has human stories. / Third, cleaning / is interpretation. / Every choice / changes the result.", "Historians do the same. / We call it / source criticism. / Messy raw data / showed me / the real world."], ["Coding is useful. / But it has limits. / System development / does, too. / The question is: / for what?", "Two ideas / helped me.", "As a mindset: / problem-driven development. / Start with / the problem.", "As a tool: / domain-driven design. / Know the domain.", "What is a domain? / It is the business / problem space."], ["Then I moved / to EdTech. / EdTech means / education technology.", "My field: / education service / for getting into university.", "Also, / tech training / and career support / for new staff.", "Why EdTech? / It is close / to research. / But I am not / at a university. / I help others / get there.", "My challenge: / can research / and development / go together?"], ["Then a friend / introduced me / to a team. / A digital history team. / I saw / two familiar names.", "Déjà vu one: / technology. / Dr. Choi / is a historian. / He started coding / long ago. / That is / my story, too.", "Déjà vu two: / tradition. / Professor Woo / is a historian. / Now he leads / a digital history team.", "So, maybe / research and development / can go together. / I am not alone.", "Before, / I felt like / a stranger. / A historian / among coders. / A coder / among historians. / Now I saw / a place for me.", "Our first workshop: / network analysis."], ["I work alone. / So I borrowed / agile methods. / Solo agile research.", "First round: / network analysis, / sentiment analysis, / digital mapping.", "Then, again. / Network analysis two. / Sentiment analysis two. / Digital mapping two.", "Sprint: / basic attempts, / small fixes, / repeat.", "Test-driven: / fail, / pass, / and refactor. / Like developers do."], ["Slowly, I found / a method. / I call it / two tracks.", "Track one: / traditional. / I read. / I think. / I test an idea. / I wait / for a case.", "Then a case appears. / Now I switch / to digital. / I count. / I visualize. / I make a guess.", "Then I go back / to the sources. / Then I switch again. / Back and forth, / like breathing.", "Why does it work? / Each side helps / the other improve.", "Tradition stops / digital work / becoming a toy. / Digital work / stops tradition / repeating itself."], ["Now, four cases.", "Case one: / independence movement / network. / Koreans in Russia.", "My source / was a list / of people. / My method: / human data extraction. / I did it / by hand.", "Then I made / a network. / Colors show / groups. / My finding: / a green group. / I had not / noticed it before.", "My hypothesis: / an armed / resistance group.", "But there are limits. / The dataset / is too small. / Many edges / are missed. / It is a hypothesis, / not a conclusion."], ["Case two: / academic network / of the Oriental Institute.", "Vladivostok Oriental Institute. / It opened / in 1899. / In 1920, / it became / a state university.", "My method: / LLM extraction. / A human / on the loop. / The LLM helps. / A human checks.", "Then I measured / centrality. / Who is / most connected?", "My finding: / a small gap. / Japanese and Korean / Studies were close. / My hypothesis: / similar roles / on the same / academic boards.", "But be careful. / My data has / limited edges. / It comes from / one sourcebook."], ["Case three: / Koreatown, 1911. / This is Vladivostok. / K means Koreans. / C means Chinese.", "Look at / the Koreans. / I used / three colors.", "Blue is / the west. / Naturalized Koreans. / Russian Orthodox.", "Yellow is / the east. / Non-naturalized Koreans. / Presbyterian.", "Green is / the center. / A mixed area.", "Three colors, / three groups. / A map / shows religion / and nationality."], ["Case four: / world Koreatowns / and metrics. / My goal: / find world Koreatowns / on a digital map.", "I built / a digital map. / Anyone can open it.", "Then I checked / the metrics. / In three months, / 9,170 search impressions.", "A digital map / can reach people. / That gave me / motivation."], ["Now, my current work. / I explore issues / through assembly records.", "First, social science. / Germany, / 1850 to 2024. / Women and migrants / discourse.", "Second, history. / Korea, / 1948 to 1961. / Technology and foreigner / discourse. / This one / is in progress.", "Third, education. / Korea, Japan, / US, France. / 2001 to 2026. / A customized monthly / dashboard. / The topic: / educational issues.", "For annotation, / I mainly use Claude. / I write / markdown rules.", "A note: / in industry, / my analysis / is low-resource. / Deep analysis / needs human review."], ["Now, Japan. / Here, digital humanities / meets industry.", "On the left: / REKICHIZU. / A digital map / of the Edo era. / MIERUNE / and the National / Institute of Informatics.", "On the right: / Evo-Ukiyoe. / Ukiyoe / in Azabudai Hills. / Sakana AI / and the Art Research / Center at Ritsumeikan.", "These are / long partnerships. / Industry and academia / work together. / Real cases / give me inspiration."], ["So, where / am I now? / I feel closer / than before.", "Why does / the domain matter? / One: / start with / real work.", "Two: / code can count. / But the domain / knows what counts.", "Three: / sometimes, / done is better / than perfect.", "Here is / a good cycle. / History gives questions. / Digital gives tools. / Tools bring / new questions. / And again."], ["My message / is simple. / Start with the domain. / Start small.", "If you come / from data, / ask historical / questions. / If you come / from the humanities, / start small. / One script. / One dataset. / Keep your / classic habits. / They are / your strength.", "Digital history / does not replace / traditional history. / It helps / history travel further.", "Thank you / very much. / I look forward / to your questions."]], TITLES=["Between History and Code", "Who I Am", "A Historian's Habits", "Who Goes Abroad?", "Why I Started Coding", "Hard Work, Messy Data", "Is Coding Enough?", "Career Move: EdTech", "Déjà Vu: A Digital History", "Solo Agile Research: Trial and Error", "Two Tracks: Switch and Repeat", "Independence Movement Network", "Academic Network of Oriental Institute", "Case 3: Koreatown, 1911", "Case 4: World Koreatowns and Metrics", "Exploring Issues Through Assembly Records", "Where DH Meets Industry", "Why the Domain Matters", "Start with the domain. Start small."];
const slides=[...document.querySelectorAll('.slide')], N=slides.length;
const isPres=location.hash==='#presenter'||window.name==='bhc-presenter';
let i=0, pw=null, t0=null;
const $=id=>document.getElementById(id);
function scriptHTML(k){return NOTES[k].map(p=>'<p>'+p.split(' / ').map(x=>'<span>'+x+'</span>').join('')+'</p>').join('')}
function fitStage(){const s=Math.min(innerWidth/1000,innerHeight/562.5);$('stage').style.transform='scale('+s+')'}
function buildBar(){const b=$('bar');for(let k=0;k<N;k++){const s=document.createElement('i');s.title='Slide '+(k+1)+' · '+TITLES[k];s.onclick=e=>{e.stopPropagation();go(k)};b.appendChild(s)}}
function renderBar(){[...$('bar').children].forEach((s,k)=>{s.className=k<i?'on':k===i?'cur':''})}
function render(){
  slides.forEach((e,k)=>e.classList.toggle('on',k===i));
  if(!isPres)renderBar();
  if(isPres){$('pvn').textContent='Slide '+(i+1)+' / '+N;$('pvt').textContent=TITLES[i];$('pvs').innerHTML=scriptHTML(i);
    $('pvx').textContent=i<N-1?'Next: '+TITLES[i+1]:'End of talk';}
  else if($('drawer').classList.contains('on')){$('drawer').innerHTML=scriptHTML(i)}
}
function go(n,fromRemote){
  n=Math.max(0,Math.min(N-1,n)); if(n===i&&!fromRemote)return; i=n; if(!t0&&isPres)start();
  render(); if(!isPres)history.replaceState(null,'','#'+(i+1));
  const o=isPres?window.opener:pw; if(!fromRemote&&o&&!o.closed)o.postMessage({go:i},'*');
}
function start(){t0=Date.now();setInterval(()=>{const s=Math.floor((Date.now()-t0)/1000);$('tm').textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')},500)}
addEventListener('message',e=>{if(e.data&&typeof e.data.go==='number')go(e.data.go,true)});
addEventListener('keydown',e=>{
  const k=e.key;
  if(['ArrowRight','PageDown',' ','Enter','ArrowDown'].includes(k)){e.preventDefault();go(i+1)}
  else if(['ArrowLeft','PageUp','Backspace','ArrowUp'].includes(k)){e.preventDefault();go(i-1)}
  else if(k==='Home')go(0); else if(k==='End')go(N-1);
  else if(!isPres&&(k==='f'||k==='F')){document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen()}
  else if(!isPres&&(k==='n'||k==='N')){$('drawer').classList.toggle('on');render()}
  else if(!isPres&&(k==='p'||k==='P')){pw=window.open(location.href.split('#')[0]+'#presenter','bhc-presenter','width=1000,height=720');setTimeout(()=>pw&&pw.postMessage({go:i},'*'),600)}
});
if(isPres){document.body.classList.add('pres');$('tm').onclick=()=>location.reload();}
else{
  fitStage();addEventListener('resize',fitStage);
  $('stage').addEventListener('click',e=>go(i+1));
  let sx=null;addEventListener('touchstart',e=>sx=e.touches[0].clientX,{passive:true});
  addEventListener('touchend',e=>{if(sx===null)return;const d=e.changedTouches[0].clientX-sx;if(Math.abs(d)>40)go(i+(d<0?1:-1));sx=null});
  setTimeout(()=>$('help').style.opacity=0,5000);
}
if(!isPres)buildBar();
const h=parseInt(location.hash.slice(1));if(h>=1&&h<=N)i=h-1;
render();
</script>
</body>
</html>
