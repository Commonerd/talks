<title>Between History and Code</title>
<style>
:root{--ink:#14202B;--text:#1F2933;--muted:#5B6670;--brick:#B4472A;--teal:#2A6F6B;--line:#D9DEE3;
  --h:HeadF,Cambria,Georgia,serif;--b:BodyF,Calibri,"Segoe UI",system-ui,sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:#0B1218;overflow:hidden;font-family:var(--b);-webkit-font-smoothing:antialiased}
#view{position:fixed;inset:0;display:flex;align-items:center;justify-content:center}
#stage{position:relative;width:1000px;height:562.5px;flex:none;transform-origin:center center}
.slide{position:absolute;inset:0;background:#fff;color:var(--text);display:none;overflow:hidden}
.slide.on{display:block}
.slide.dark{background:var(--ink)}

.slide>*{position:absolute}
.tx{display:flex;flex-direction:column;box-sizing:border-box;font-family:var(--b);color:#1F2933;line-height:1.22;overflow:visible}
.tx p{margin:0;font-size:18px;line-height:inherit}
.tx span{line-height:inherit}
.sh{box-sizing:border-box}
.im{display:block}
.ln{transform-origin:0 50%}
.ln i{position:absolute;top:50%;margin-top:-6px;border-top:6px solid transparent;border-bottom:6px solid transparent;width:0;height:0}
.tb{border-collapse:collapse;table-layout:fixed;font-family:var(--b);color:#1F2933}
.tb td{border:1px solid #D9DEE3;vertical-align:top;line-height:1.22}
.tb p{margin:0}
#bar{position:fixed;left:0;right:0;bottom:0;height:8px;display:flex;gap:2px;z-index:5;cursor:pointer;transition:height .15s}
#bar:hover{height:16px}
#bar i{flex:1;background:rgba(140,150,160,.38);transition:background .25s}
#bar i.on{background:#B4472A}
#bar i.cur{background:#2A6F6B}
#bar i:hover{filter:brightness(1.25)}
body.pres #bar{display:none}
/* notes drawer */
#drawer{position:fixed;left:0;right:0;bottom:0;max-height:46vh;overflow:auto;background:rgba(11,18,24,.96);color:#fff;padding:18px 28px 22px;display:none;font-family:var(--b);border-top:1px solid #2b3946}
#drawer.on{display:block}
#help{position:fixed;right:14px;top:12px;color:#8fa0ae;font-size:13px;background:rgba(11,18,24,.8);padding:6px 10px;border-radius:6px;transition:opacity .6s}
.sc p{margin:0 0 .9em}
.sc span{display:block;font-size:var(--fs,26px);line-height:1.35}
.sc span.pa{opacity:.55}
/* presenter window */
body.pres #view,body.pres #help{display:none}
#pv{display:none;position:fixed;inset:0;background:#0B1218;color:#fff;padding:22px 34px;overflow:auto}
body.pres #pv{display:block}
#pv .bar{display:flex;gap:24px;align-items:baseline;color:#8fa0ae;font-size:18px;margin-bottom:6px}
#pv .tm{font:700 40px var(--b);color:#fff;cursor:pointer}
#pv h2{font:700 30px var(--h);margin:6px 0 18px}
#pv .nx{margin-top:22px;color:#8fa0ae;font-size:18px}
#pv .hint{margin-top:26px;color:#5f7080;font-size:14px}
@media print{html,body{overflow:visible;height:auto;background:#fff}#view{position:static;display:block}#stage{transform:none!important;width:auto;height:auto}.slide{display:block!important;position:relative;width:1000px;height:562.5px;page-break-after:always}#drawer,#help{display:none!important}}
@page{size:1000px 562.5px;margin:0}

@font-face{font-family:BodyF;font-weight:400;font-style:normal;src:url(data:font/woff;base64,) format('woff')}
